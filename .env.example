# Sao chép thành .env ở thư mục gốc để docker compose đọc.

# --- PostgreSQL ---
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite

# --- Backend (NestJS) ---
# Khi chạy bằng docker compose, host DB là "db"; khi chạy tay trên máy là "localhost".
DATABASE_URL=postgres://brewlite:brewlite@db:5432/brewlite
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat-dai
JWT_EXPIRES_IN_SECONDS=86400
CORS_ORIGIN=http://localhost:3000
BACKEND_PORT=4000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
